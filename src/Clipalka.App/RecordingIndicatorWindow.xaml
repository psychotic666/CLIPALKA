<Window x:Class="Clipalka.App.RecordingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="142" Height="42" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Focusable="False">
    <Border Margin="5" Background="#E817181D" BorderBrush="#444650" BorderThickness="1"
            CornerRadius="12" IsHitTestVisible="False">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.45" /></Border.Effect>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="#F04461" Margin="0,0,8,0" />
            <TextBlock Text="REC" Foreground="#F04461" FontSize="10" FontWeight="Bold" Margin="0,0,8,0" />
            <TextBlock x:Name="TimerText" Text="00:00" Foreground="#F7F7FA" FontSize="10" FontWeight="SemiBold" />
        </StackPanel>
    </Border>
</Window>
