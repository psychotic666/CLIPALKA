<Window x:Class="Clipalka.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Clipalka.App.Controls"
        Title="CLIPALKA" Icon="Assets/clipalka.ico" Width="1585" Height="992" MinWidth="960" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="4"/></shell:WindowChrome.WindowChrome>
    <Border x:Name="ShellRoot" Background="{StaticResource StudioCanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
            <Border Grid.Column="1" Background="{StaticResource StudioCanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="4,4,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CLIPALKA" FontFamily="Segoe UI Black" FontSize="20" FontWeight="Black" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" AutomationProperties.Name="Свернуть"><Path Data="M0,5 L12,5" Stroke="{StaticResource TextBrush}" StrokeThickness="1" Width="12" Height="10"/></Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" AutomationProperties.Name="Развернуть или восстановить"><Rectangle Width="12" Height="12" Stroke="{StaticResource TextBrush}" StrokeThickness="1"/></Button>
                        <Button Style="{StaticResource CloseTitleBarButton}" Click="CloseButton_Click" AutomationProperties.Name="Закрыть в трей"><Path Data="M0,0 L12,12 M0,12 L12,0" Stroke="{StaticResource TextBrush}" StrokeThickness="1.2" Width="12" Height="12"/></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.RowSpan="3" Background="{StaticResource SidebarBrush}">
                <StackPanel>
                    <Image Source="Assets/clipalka-icon.png" Width="44" Height="44" Margin="0,17,0,29" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="CLIPALKA"/>
                    <Button x:Name="DashboardNavButton" Style="{StaticResource StudioTab}" Click="DashboardNavButton_Click" AutomationProperties.Name="Захват"><StackPanel Orientation="Vertical"><Path Style="{StaticResource NavGlyph}" Margin="0,0,0,4" HorizontalAlignment="Center" Data="{StaticResource CaptureTabGlyph}"/><TextBlock Text="Захват" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="ClipsNavButton" Style="{StaticResource StudioTab}" Click="ClipsNavButton_Click" AutomationProperties.Name="Мои клипы"><StackPanel Orientation="Vertical"><Path Style="{StaticResource NavGlyph}" Margin="0,0,0,4" HorizontalAlignment="Center" Data="{StaticResource ClipsTabGlyph}"/><TextBlock Text="Клипы" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="HotkeysNavButton" Style="{StaticResource StudioTab}" Click="HotkeysNavButton_Click" AutomationProperties.Name="Настройки"><StackPanel Orientation="Vertical"><Path Style="{StaticResource NavGlyph}" Margin="0,0,0,4" HorizontalAlignment="Center" Data="{StaticResource SettingsTabGlyph}"/><TextBlock Text="Настройки" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <Border x:Name="ErrorBanner" Grid.Row="1" Visibility="Collapsed" Margin="28,0,28,8" Background="#39202D" BorderBrush="#8C3B54" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                        <Path Style="{StaticResource StudioIcon}" Data="{StaticResource WarningIcon}" Stroke="#FF9CB1" Width="20" Height="20"/>
                        <StackPanel Grid.Column="1"><TextBlock Foreground="White" x:Name="ErrorBannerTitle" Text="Операция не выполнена" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="ErrorBannerText" Foreground="#F4B9C4" FontSize="13" TextWrapping="Wrap" Margin="0,4,12,0"/></StackPanel>
                        <Button Grid.Column="2" Content="×" Style="{StaticResource QuietButton}" Padding="0" FontSize="20" Click="DismissErrorButton_Click" AutomationProperties.Name="Скрыть сообщение об ошибке"/>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="DashboardPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="DashboardLayoutGrid" Margin="28,24,28,20" MaxWidth="1480">
                        <Grid x:Name="DashboardHeadingGrid" Height="68" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="GreetingText" Text="Монтажный стол" FontFamily="{StaticResource DisplayFace}" FontSize="44" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="14" Padding="12,5" Background="#272232"><StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="CaptureStateDot" Width="9" Height="9" Fill="{StaticResource SubtleBrush}" Margin="0,0,10,0"/>
                                <TextBlock x:Name="CaptureStateText" Text="Буфер выключен" Foreground="{StaticResource MutedBrush}" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel></Border>
                        </Grid>
                        <Grid x:Name="CaptureDesk">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2.25*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*" MinWidth="236"/></Grid.ColumnDefinitions>
                        <controls:RoundedClipBorder x:Name="CapturePreviewBorder" Background="{StaticResource PreviewBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <Grid.Background><ImageBrush x:Name="CapturePreviewBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/></Grid.Background>
                                <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#000D0F16" Offset="0.6"/><GradientStop Color="#900D0F16" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                <StackPanel x:Name="PreviewEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{StaticResource LeaderArt}" Width="144" Height="76" Stretch="Uniform"/>
                                    <TextBlock Foreground="#F5F5F6" Text="Первый клип появится здесь" FontSize="19" FontFamily="{StaticResource DisplayFace}" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                    <TextBlock Foreground="#BABBC2" Text="Запусти игру и сохрани последние 30 секунд" Style="{StaticResource Caption}" FontSize="15" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                                <Border x:Name="LatestClipLabel" Visibility="Collapsed" Background="#D516121F" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" IsHitTestVisible="False">
                                    <TextBlock Foreground="White" Text="Последний клип" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22" MaxWidth="650">
                                    <TextBlock Foreground="White" x:Name="PreviewCaptionText" Text="Нет сохранённых клипов" FontSize="23" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="LatestClipMetadataText" FontSize="14" Foreground="#E1E1E5" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Button x:Name="OpenLatestClipButton" Style="{StaticResource CircularActionButton}" Width="76" Height="76" Background="#70111213" BorderBrush="White" HorizontalAlignment="Center" VerticalAlignment="Center" Click="OpenClip_Click" IsEnabled="False" AutomationProperties.Name="Воспроизвести последний клип">
                                    <Path Data="M0,0 L20,13 L0,26 Z" Fill="White" Width="20" Height="26" Margin="5,0,0,0"/>
                                    <Button.Visibility><Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}"><Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter></Binding></Button.Visibility>
                                </Button>
                                <Border Visibility="{Binding Visibility, ElementName=LatestClipLabel}" Background="#D516121F" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18">
                                    <TextBlock Foreground="White" x:Name="LatestClipDurationText" Text="—" FontFamily="Consolas" FontSize="15"/>
                                </Border>
                            </Grid>
                        </controls:RoundedClipBorder>

                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,2,0,1" Padding="0,12,0,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Недавние клипы" FontFamily="{StaticResource DisplayFace}" FontWeight="Bold" FontSize="21" Margin="0,0,0,10"/>
                                <Button DockPanel.Dock="Bottom" Content="Открыть галерею  →" Style="{StaticResource QuietButton}" Click="ClipsNavButton_Click" HorizontalAlignment="Left" Padding="8,4" MinHeight="30"/>
                                <Grid><ItemsControl x:Name="RecentClipsItemsControl" VerticalAlignment="Top">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Tag="{Binding FilePath}" Click="OpenClip_Click" AutomationProperties.Name="{Binding Title}" HorizontalContentAlignment="Stretch"
                                                BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}" Background="Transparent" Padding="0,8">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Height="50" Background="{StaticResource PreviewBrush}"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill" ClipToBounds="True"/></Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding SavedAt}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="RecentClipsEmptyText" Text="Здесь будут три последних клипа." TextWrapping="Wrap" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                        </Grid>
                        <Grid x:Name="CaptureActionsGrid" Height="84" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="ReplayButton" TabIndex="0" Style="{StaticResource StudioReplayButton}" Click="ReplayButton_Click" AutomationProperties.Name="Сохранить последние 30 секунд">
                                <Grid x:Name="ReplayActionLayout"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                    <TextBlock x:Name="ReplayButtonTitle" Foreground="#211333" Text="Сохранить момент" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

                                    <Border x:Name="ReplayShortcutChip" Grid.Row="1" HorizontalAlignment="Left" Padding="0" BorderThickness="0" Style="{StaticResource SignalShortcut}" Margin="0" BorderBrush="#D8C4FF"><TextBlock x:Name="ReplayHotkeyHint" Foreground="#3D2559" Text="Shift + Z" Style="{StaticResource SignalShortcutText}"/></Border>
                                </Grid>
                            </Button>
                            <Button x:Name="RecordButton" TabIndex="1" Grid.Column="2" Style="{StaticResource StudioActionButton}" Click="RecordButton_Click" AutomationProperties.Name="Начать или остановить запись">
                                <Grid x:Name="RecordActionLayout"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="22" Margin="0,0,12,0"><Ellipse x:Name="RecordStartGlyph" Width="20" Height="20" Stroke="{StaticResource TextBrush}" StrokeThickness="2"/><Rectangle x:Name="RecordStopGlyph" Width="18" Height="18" RadiusX="2" RadiusY="2" Fill="{StaticResource DangerBrush}" Visibility="Collapsed"/></Grid><TextBlock x:Name="RecordButtonTitle" Text="Начать запись" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                                    <Border x:Name="RecordShortcutChip" Grid.Row="1" HorizontalAlignment="Left" Padding="0" BorderThickness="0" Style="{StaticResource SignalShortcut}" Margin="0"><TextBlock x:Name="RecordHotkeyHint" Text="Shift + R" Style="{StaticResource SignalShortcutText}"/></Border>
                                </Grid>
                            </Button>
                            <Button x:Name="MicrophoneButton" TabIndex="2" Grid.Column="4" Style="{StaticResource StudioActionButton}" Click="MicrophoneButton_Click" AutomationProperties.Name="Включить или выключить микрофон">
                                <Grid x:Name="MicrophoneActionLayout"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path x:Name="MicrophoneIcon" Style="{StaticResource StudioIcon}" Data="{StaticResource MicIcon}" Width="22" Height="27" Stroke="{StaticResource SuccessBrush}" Margin="0,0,10,0"/><TextBlock x:Name="MicrophoneButtonTitle" Text="Микрофон" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                                    <TextBlock x:Name="MicrophoneHotkeyHint" Grid.Row="1" Style="{StaticResource SignalShortcutText}" VerticalAlignment="Center" Margin="0,2,0,0"/>
                                    <controls:AudioLevelMeter x:Name="MicrophoneLevelMeter" Grid.Column="1" Grid.RowSpan="2" Width="84" Height="22" Margin="10,0,0,0" VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False" AutomationProperties.Name="Уровень микрофона"/>
                                </Grid>
                            </Button>
                        </Grid>
                        <Grid x:Name="QuickSettingsGrid" Margin="0,12,0,0" Height="48">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource StudioQuickButton}" Click="VideoNavButton_Click" AutomationProperties.Name="Настроить источник захвата">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CaptureQualityText" Grid.Column="2" Text="60 FPS" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="8,0"/>
                                    <Path x:Name="SourceIdentityIcon" Style="{StaticResource StudioIcon}" Data="{StaticResource GameIcon}" Stroke="{StaticResource TextBrush}"/>
                                    <TextBlock x:Name="ReplaySourceText" Grid.Column="1" Text="Источник не выбран" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource ChevronRightIcon}" Grid.Column="3" Width="12" Height="14"/>
                                </Grid>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource StudioQuickButton}" Click="AudioSettingsNavButton_Click" AutomationProperties.Name="Настроить звук">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource AudioIcon}" Stroke="{StaticResource TextBrush}"/>
                                    <TextBlock x:Name="AudioSummaryText" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Grid.Column="1" Text="Аудио: системное устройство" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource ChevronRightIcon}" Grid.Column="2" Width="12" Height="14"/>
                                </Grid>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource StudioQuickButton}" Click="OpenClipsFolder_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions><Path Style="{StaticResource StudioIcon}" Data="{StaticResource FolderIcon}" Stroke="{StaticResource TextBrush}"/><TextBlock Grid.Column="1" Text="Папка клипов" FontSize="16" VerticalAlignment="Center"/><Path Style="{StaticResource StudioIcon}" Data="{StaticResource ChevronRightIcon}" Grid.Column="2" Width="12" Height="14"/></Grid>
                            </Button>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                    <!-- Clips page -->
                    <ScrollViewer x:Name="AudioPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="28,24,12,24" MaxWidth="1440" HorizontalAlignment="Stretch">
                            <TextBlock Text="Киноархив" Style="{StaticResource PageHeading}" />
                            <TextBlock x:Name="GalleryCountText" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,6,0,18" />
                            <TextBlock Text="Поиск по игре или названию" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                            <DockPanel Margin="0,0,0,20"><Button Content="Открыть папку" DockPanel.Dock="Right" Click="OpenClipsFolder_Click" Margin="12,0,0,0" /><Button Content="Обновить" DockPanel.Dock="Right" Click="RefreshClips_Click" Margin="12,0,0,0" /><TextBox x:Name="ClipSearchTextBox" TextChanged="ClipSearch_TextChanged" ToolTip="Поиск по имени игры или клипа" AutomationProperties.Name="Поиск клипов" /></DockPanel>
                            <ItemsControl x:Name="GalleryItemsControl">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Padding="0,0,0,12" Margin="0,0,16,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <Button Tag="{Binding FilePath}" Click="OpenClip_Click" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Height="180" ToolTip="Воспроизвести клип" AutomationProperties.Name="{Binding Title}">
                                                <Grid><Grid.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/></Grid.Background><Border Background="#DC111213" Padding="7,4" CornerRadius="5" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8"><TextBlock Foreground="White" Text="{Binding Duration}" FontSize="12" /></Border></Grid>
                                            </Button>
                                            <DockPanel Margin="5,9,2,3">
                                                <Button DockPanel.Dock="Right" Tag="{Binding FilePath}" Click="RevealClip_Click" ToolTip="Показать в папке" AutomationProperties.Name="Показать в папке" Width="36" MinHeight="34" Padding="8"><Path Style="{StaticResource StudioIcon}" Data="{StaticResource FolderIcon}" Width="16" Height="16"/></Button>
                                                <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SavedAt}" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="GalleryEmptyPanel" Style="{StaticResource SettingsPanel}" Padding="28">
                                <StackPanel HorizontalAlignment="Center" Margin="0,50">
                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource ClipsIcon}" Width="42" Height="42" Stroke="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="GalleryEmptyTitle" FontFamily="{StaticResource DisplayFace}" Text="Пока нет клипов" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                                    <TextBlock x:Name="GalleryEmptyHint" Text="Сохрани момент на экране захвата." Foreground="{StaticResource MutedBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,18" />
                                    <Button Content="Открыть папку с клипами" Foreground="White" Background="{StaticResource AccentBrush}" Click="OpenClipsFolder_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>



                <Grid x:Name="SettingsShell" Grid.Row="2" Visibility="Collapsed" MaxWidth="1180" Margin="32,20,32,24">
                    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><TextBlock Text="Настройки" Style="{StaticResource PageHeading}"/><Button x:Name="SaveAllSettingsButton" Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" MinHeight="40" Padding="20,8" Click="SaveSettingsButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,8">
                        <Button x:Name="VideoNavButton" Style="{StaticResource SettingsTab}" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,6" Click="VideoNavButton_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavGlyph}" Data="{StaticResource CaptureTabGlyph}"/><TextBlock Text="Видео и файлы" FontSize="14"/></StackPanel></Button>
                        <Button x:Name="AudioSettingsNavButton" Style="{StaticResource SettingsTab}" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,6" Click="AudioSettingsNavButton_Click" AutomationProperties.Name="Настроить звук"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource StudioIcon}" Data="{StaticResource AudioIcon}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Аудио" FontSize="14"/></StackPanel></Button>
                        <Button x:Name="ControlsNavButton" Style="{StaticResource SettingsTab}" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,6" Click="ControlsNavButton_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource StudioIcon}" Data="{StaticResource KeyboardIcon}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Клавиатура и геймпад" FontSize="14"/></StackPanel></Button>
                    </StackPanel>
                    <ScrollViewer x:Name="VideoPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,12,16">
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,16"><StackPanel>
                                <TextBlock Text="Изображение" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,22"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,0,20"><TextBlock Text="Резервный монитор" Style="{StaticResource FieldLabel}" FontSize="14"/><ComboBox x:Name="DisplayComboBox" DisplayMemberPath="Name" AutomationProperties.Name="Резервный монитор"/></StackPanel>
                                    <StackPanel Grid.Column="2"><StackPanel Margin="0,0,0,20"><TextBlock Text="Частота кадров" Style="{StaticResource FieldLabel}" FontSize="14"/><ComboBox x:Name="FpsComboBox" SelectedValuePath="Content" AutomationProperties.Name="Частота кадров"><ComboBoxItem Content="30"/><ComboBoxItem Content="60" IsSelected="True"/><ComboBoxItem Content="120"/></ComboBox></StackPanel></StackPanel>
                                </Grid>
                                <TextBlock Text="При автоматическом захвате игра остаётся источником при переключении окон. Монитор используется для записи экрана." Style="{StaticResource Caption}" FontSize="14"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,16"><StackPanel>
                                <TextBlock Text="Папка для записей" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputPathTextBox" AutomationProperties.Name="Папка для записей"/><Button Grid.Column="1" Content="Обзор…" Margin="12,0,0,0" MinWidth="100" Click="BrowseOutputPath_Click"/></Grid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,16"><StackPanel>
                                <TextBlock Text="Поведение захвата" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                <CheckBox x:Name="AutoGameCheckBox" Style="{StaticResource ToggleCheckBox}" Content="Автоматически выбирать активную игру" IsChecked="True"/>
                                <CheckBox x:Name="StartReplayCheckBox" Style="{StaticResource ToggleCheckBox}" Content="Запускать replay вместе с CLIPALKA" IsChecked="True"/>
                                <CheckBox x:Name="StartWithWindowsCheckBox" Style="{StaticResource ToggleCheckBox}" Content="Запускать CLIPALKA вместе с Windows"/>
                                <TextBlock Text="Приложение откроется после входа в Windows. Применяется кнопкой «Сохранить настройки»." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsPanel}"><StackPanel>
                                <TextBlock Text="Проверка записи и звука" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Сохраняет отдельно голос, звук игры, видео и журнал кадров на этом компьютере. Проверка останавливает replay примерно через 90 секунд или при достижении 2 ГБ." Style="{StaticResource Caption}" FontSize="14" Margin="0,12,0,18"/>
                                <WrapPanel><Button x:Name="DiagnosticsButton" Content="Начать проверку (90 секунд)" Click="DiagnosticsButton_Click" Margin="0,0,12,0"/><Button Content="Открыть папку проверки" Click="OpenDiagnosticsButton_Click"/></WrapPanel>
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="SoundPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,12,16">
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,16"><StackPanel>
                                <TextBlock Text="Системный звук" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
                                <StackPanel Margin="0,0,0,20"><TextBlock Text="Устройство вывода / Sonar Gaming" Style="{StaticResource FieldLabel}" FontSize="14"/><ComboBox x:Name="OutputDeviceComboBox" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Устройство вывода"/></StackPanel>
                                <TextBlock Text="В клип попадёт звук, проходящий через выбранное устройство." Style="{StaticResource Caption}" FontSize="14" Margin="0,0,0,16"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider x:Name="OutputVolumeSlider" Style="{StaticResource VolumeSlider}" Value="100" AutomationProperties.Name="Громкость системы"/><TextBlock Grid.Column="1" Text="{Binding Value, ElementName=OutputVolumeSlider, StringFormat={}{0:0}%}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsPanel}"><StackPanel>
                                <TextBlock Text="Микрофон" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
                                <StackPanel Margin="0,0,0,20"><TextBlock Text="Устройство ввода / Sonar Microphone" Style="{StaticResource FieldLabel}" FontSize="14"/><ComboBox x:Name="InputDeviceComboBox" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Устройство микрофона"/></StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider x:Name="MicrophoneVolumeSlider" Style="{StaticResource VolumeSlider}" Value="100" AutomationProperties.Name="Громкость микрофона"/><TextBlock Grid.Column="1" Text="{Binding Value, ElementName=MicrophoneVolumeSlider, StringFormat={}{0:0}%}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="HotkeysPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,12,16">
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Replay с контроллера" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Text="DualSense по Bluetooth / USB, Flydigi и другие контроллеры Windows. Выбери устройство, нажми «Назначить» и введи сочетание кнопками геймпада." TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,16" />
                                    <TextBlock Text="Устройство" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ControllerComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Tag="Контроллер не подключён" AutomationProperties.Name="Контроллер для replay" MinWidth="0" />
                                    <WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource QuietButton}" Content="Обновить список" Click="RefreshControllers_Click" Padding="12,6" MinHeight="34" Margin="0,0,10,0" /><Button Style="{StaticResource QuietButton}" Content="Контроллеры Windows" Click="OpenWindowsControllers_Click" Padding="12,6" MinHeight="34" Margin="0,0,10,0" /><Button Style="{StaticResource QuietButton}" Content="Скопировать сведения" Click="CopyControllerDetails_Click" Padding="12,6" MinHeight="34" /></WrapPanel>
                                    <TextBlock x:Name="ControllerStatusText" Text="Подключи контроллер, чтобы назначить сочетание" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,10,0,16" />
                                    <Border Background="{StaticResource ContentBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12"><StackPanel>
                                        <TextBlock Text="Ввод с контроллера" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock x:Name="ControllerInputText" Text="Нажми кнопки — здесь появится распознанный ввод" FontSize="14" Foreground="{StaticResource AccentHoverBrush}" TextWrapping="Wrap"/>
                                    </StackPanel></Border>
                                    <Border Background="{StaticResource InputBrush}" CornerRadius="4" Padding="16,12"><TextBlock x:Name="ControllerBindingText" Text="Не назначено" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /></Border>
                                    <WrapPanel Margin="0,14,0,0"><Button x:Name="LearnControllerButton" Style="{StaticResource PrimaryButton}" MinHeight="42" Content="Назначить сочетание" Click="LearnControllerButton_Click" Margin="0,0,12,0" /><Button Content="Отключить" Click="ClearControllerButton_Click" /></WrapPanel>
                                    <CheckBox x:Name="ControllerGameOnlyCheckBox" Style="{StaticResource ToggleCheckBox}" Content="Геймпад срабатывает только в активной игре" Margin="0,14,0,0"/>
                                    <TextBlock Text="Нажми сочетание один раз. Другие игровые кнопки не мешают. Перед следующим клипом отпусти кнопки сочетания. Назначение применяется после сохранения настроек." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,16"><StackPanel>
                                <TextBlock Text="Горячие клавиши" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Нажми поле и введи сочетание на клавиатуре. Escape отключает хоткей. Названия клавиш всегда на английском." Style="{StaticResource Caption}" FontSize="14" Margin="0,10,0,22"/>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock Text="Начать / остановить запись" FontSize="15" VerticalAlignment="Center"/><TextBox x:Name="RecordHotkeyTextBox" Grid.Column="1" Style="{StaticResource HotkeyBox}" MinHeight="44" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Начать / остановить запись"/></Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock Text="Сохранить последние 30 секунд" FontSize="15" VerticalAlignment="Center"/><TextBox x:Name="ReplayHotkeyTextBox" Grid.Column="1" Style="{StaticResource HotkeyBox}" MinHeight="44" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Сохранить последние 30 секунд"/></Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock Text="Вкл. / выкл. микрофон" FontSize="15" VerticalAlignment="Center"/><TextBox x:Name="MicrophoneHotkeyTextBox" Grid.Column="1" Style="{StaticResource HotkeyBox}" MinHeight="44" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Вкл. / выкл. микрофон"/></Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock Text="Открыть галерею" FontSize="15" VerticalAlignment="Center"/><TextBox x:Name="GalleryHotkeyTextBox" Grid.Column="1" Style="{StaticResource HotkeyBox}" MinHeight="44" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Открыть галерею"/></Grid>
                                <CheckBox x:Name="GameOnlyHotkeysCheckBox" Style="{StaticResource ToggleCheckBox}" Content="Клавиатурные хоткеи только в активной игре" IsChecked="True" Margin="0,8,0,0"/>
                            </StackPanel></Border>
                            <TextBlock Text="CLIPALKA v0.9.3 · Все клипы хранятся на твоём компьютере" Style="{StaticResource Caption}" FontSize="13" Margin="4,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Grid.Row="2" Background="#17151E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="ReplayStatusDot" Width="6" Height="6" Fill="{StaticResource SubtleBrush}" Margin="0,0,7,0"/><TextBlock x:Name="ReplayStatusText" Text="Replay выключен" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0"/></StackPanel>
                    <TextBlock x:Name="CaptureDescriptionText" Grid.Column="1" Text="Replay-буфер выключен" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock x:Name="StatusTextBlock" Grid.Column="2" Text="Готов к захвату" Foreground="{StaticResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Button x:Name="ToggleReplayButton" Grid.Column="3" Content="Включить replay" Style="{StaticResource QuietButton}" MinHeight="24" Padding="8,0" FontSize="11" Click="ToggleReplayButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
