<Window x:Class="Clipalka.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CLIPALKA" Width="920" Height="760" MinWidth="820" MinHeight="680"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CLIPALKA" FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="Записывай момент, а не разбирайся с настройками" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#182033" CornerRadius="18" Padding="14,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ReplayStatusDot" Width="8" Height="8" Fill="#64748B" Margin="0,0,8,0" />
                        <TextBlock x:Name="ReplayStatusText" Text="Replay выключен" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="22" Margin="0,28,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RecordButton" Click="RecordButton_Click" Background="#E5484D" Margin="0,0,8,0" MinHeight="76">
                        <StackPanel>
                            <TextBlock x:Name="RecordButtonTitle" Text="●  Записывать экран" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="RecordHotkeyHint" Text="Ctrl + Shift + R" Foreground="#FFD6D7" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReplayButton" Grid.Column="1" Click="ReplayButton_Click" Background="{StaticResource AccentBrush}" Margin="8,0" MinHeight="76">
                        <StackPanel>
                            <TextBlock Text="↶  Последние 30 секунд" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ReplayHotkeyHint" Text="Shift + Z" Foreground="#E9DFFF" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MicrophoneButton" Grid.Column="2" Click="MicrophoneButton_Click" Margin="8,0,0,0" MinHeight="76">
                        <StackPanel>
                            <TextBlock x:Name="MicrophoneButtonTitle" Text="🎙  Микрофон включён" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Нажмите, чтобы выключить" Foreground="#BAC3D3" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="22">
                <StackPanel>
                    <TextBlock Text="Настройки записи" FontSize="18" FontWeight="Bold" Margin="0,0,0,18" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,15">
                            <TextBlock Text="Папка для записей" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputPathTextBox" VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="Выбрать…" Margin="10,0,0,0" Click="BrowseOutputPath_Click" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Экран" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
                            <ComboBox x:Name="DisplayComboBox" DisplayMemberPath="Name" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Частота кадров" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
                            <ComboBox x:Name="FpsComboBox" SelectedValuePath="Content">
                                <ComboBoxItem Content="30" />
                                <ComboBoxItem Content="60" IsSelected="True" />
                                <ComboBoxItem Content="120" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Звук компьютера / Sonar Game" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
                            <ComboBox x:Name="OutputDeviceComboBox" DisplayMemberPath="Name" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Микрофон / Sonar Microphone" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
                            <ComboBox x:Name="InputDeviceComboBox" DisplayMemberPath="Name" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock Text="Хоткей записи (пусто = выключен)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
                            <TextBox x:Name="RecordHotkeyTextBox" ToolTip="Например: Ctrl+Shift+R" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2">
                            <TextBlock Text="Хоткей replay (пусто = выключен)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
                            <TextBox x:Name="ReplayHotkeyTextBox" ToolTip="Например: Shift+Z" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,20,0,0">
                        <CheckBox x:Name="StartReplayCheckBox" Content="Включать replay-буфер при запуске" Foreground="White" VerticalAlignment="Center" />
                        <Button Content="Сохранить настройки" HorizontalAlignment="Right" Background="{StaticResource AccentBrush}" Click="SaveSettingsButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="#101622" CornerRadius="12" Padding="14" Margin="0,16,0,0">
                <TextBlock x:Name="StatusTextBlock" Text="Подготовка…" Foreground="#B7C1D4" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </ScrollViewer>
</Window>

