<Window x:Class="Clipalka.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Clipalka.App.Controls"
        Title="CLIPALKA" Icon="Assets/clipalka.ico"
        Width="1585" Height="992" MinWidth="960" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged" SizeChanged="Window_SizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="ShellRoot" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                        <Image Source="{StaticResource BrandMark}" Width="30" Height="30" AutomationProperties.Name="CLIPALKA"/>
                        <TextBlock Text="CLIPALKA" FontSize="21" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <Border Width="1" Height="22" Background="{StaticResource BorderBrush}" Margin="24,0"/>
                        <TextBlock Text="Записывай. Сохраняй. Играй дальше." Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="SaveAllSettingsButton" Content="Сохранить настройки" Click="SaveSettingsButton_Click" MinHeight="36" Margin="0,0,18,0" Padding="16,6" ToolTip="Применить настройки видео, звука и горячих клавиш"/>
                        <Border Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" AutomationProperties.Name="Свернуть"><Path Data="M0,5 L12,5" Stroke="{StaticResource TextBrush}" StrokeThickness="1" Width="12" Height="10"/></Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" AutomationProperties.Name="Развернуть или восстановить"><Rectangle Width="11" Height="11" RadiusX="1" RadiusY="1" Stroke="{StaticResource TextBrush}" StrokeThickness="1"/></Button>
                        <Button Style="{StaticResource CloseTitleBarButton}" Click="CloseButton_Click" AutomationProperties.Name="Закрыть в трей" ToolTip="Закрыть в трей"><Path Data="M0,0 L11,11 M0,11 L11,0" Stroke="{StaticResource TextBrush}" StrokeThickness="1.2" Width="11" Height="11"/></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,24,0,0">
                            <TextBlock Text="ПРОСТРАНСТВО" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" Margin="26,0,0,14"/>
                            <Button x:Name="DashboardNavButton" Style="{StaticResource SidebarNavButton}" Click="DashboardNavButton_Click" AutomationProperties.Name="Главная">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource HomeIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Grid.Column="1" Text="Главная" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button x:Name="ClipsNavButton" Style="{StaticResource SidebarNavButton}" Click="ClipsNavButton_Click" AutomationProperties.Name="Мои клипы">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource ClipsIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Grid.Column="1" Text="Мои клипы" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button x:Name="VideoNavButton" Style="{StaticResource SidebarNavButton}" Click="VideoNavButton_Click" AutomationProperties.Name="Запись">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource GameIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Grid.Column="1" Text="Запись" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button x:Name="HotkeysNavButton" Style="{StaticResource SidebarNavButton}" Click="HotkeysNavButton_Click" AutomationProperties.Name="Настройки">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource SettingsIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Grid.Column="1" Text="Настройки" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="16,0,16,20">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,14">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Ellipse x:Name="ReplayStatusDot" Fill="{StaticResource SuccessBrush}" Width="7" Height="7" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="ReplayStatusText" Text="CLIPALKA работает" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="StatusTextBlock" Text="Готов к захвату" Foreground="{StaticResource SubtleBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="CLIPALKA  /  v0.9.3 RC2" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="12,14,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Background="{StaticResource ContentBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <ScrollViewer x:Name="DashboardPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <Grid x:Name="DashboardLayoutGrid" Margin="28,26,28,28" MaxWidth="1480" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="DashboardMainColumn" Width="*"/><ColumnDefinition x:Name="DashboardGapColumn" Width="24"/><ColumnDefinition x:Name="DashboardRightColumn" Width="384"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="DashboardRailGapRow" Height="0"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel x:Name="DashboardMainPanel">
                                <Grid x:Name="DashboardHeadingGrid" Height="84">
                                    <StackPanel>
                                        <TextBlock x:Name="GreetingText" Text="Добрый вечер" Style="{StaticResource PageHeading}"/>
                                        <TextBlock Text="Хорошей игры. Лучшие моменты останутся с тобой." Style="{StaticResource Caption}" Margin="0,8,120,0"/>
                                    </StackPanel>
                                    <Button x:Name="ContinueButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" Click="ClipsNavButton_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="Мои клипы" FontSize="13" VerticalAlignment="Center"/><Path Style="{StaticResource StudioIcon}" Data="{StaticResource ArrowIcon}" Width="16" Height="16" Margin="8,0,0,0" /></StackPanel>
                                    </Button>
                                </Grid>

                                <Border Style="{StaticResource SettingsPanel}" Padding="18" Background="{StaticResource HeroBrush}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="48" Height="48" Background="#332A49" CornerRadius="12">
                                                <Path x:Name="SourceIdentityIcon" Style="{StaticResource StudioIcon}" Data="{StaticResource GameIcon}" Width="26" Height="26" Stroke="{StaticResource AccentHoverBrush}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="ReplaySourceText" Text="Источник не выбран" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Ellipse x:Name="CaptureStateDot" Width="7" Height="7" Fill="{StaticResource SubtleBrush}" Margin="0,0,7,0"/>
                                                    <TextBlock x:Name="CaptureStateText" Text="Ожидание захвата" Foreground="{StaticResource SubtleBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Name="ToggleReplayButton" Grid.Column="2" Content="Включить replay" FontSize="12" MinHeight="36" Padding="12,6" Click="ToggleReplayButton_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                        <controls:RoundedClipBorder x:Name="CapturePreviewBorder" Height="260" Background="{StaticResource PreviewBrush}" BorderBrush="#373343" BorderThickness="1" CornerRadius="10">
                                            <Grid>
                                                <Image x:Name="CapturePreviewImage" Stretch="UniformToFill"/>
                                                <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#050C0D12" Offset="0.4"/><GradientStop Color="#C00C0D12" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                                <StackPanel x:Name="PreviewEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,20,28">
                                                    <Border Width="58" Height="58" Background="#443E315E" BorderBrush="#695A4985" BorderThickness="1" CornerRadius="18" HorizontalAlignment="Center"><Path Style="{StaticResource StudioIcon}" Data="{StaticResource CaptureIcon}" Width="28" Height="28" Stroke="{StaticResource AccentHoverBrush}" /></Border>
                                                    <TextBlock Text="Момент стоит сохранить" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                                    <TextBlock Text="Запусти игру и сохрани первый replay" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                </StackPanel>
                                                <Border Background="#DE191922" CornerRadius="6" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14">
                                                    <TextBlock x:Name="CaptureQualityText" Text="H.264  ·  60 FPS  ·  Stereo" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock x:Name="PreviewCaptionText" Text="Предпросмотр появится после сохранения клипа" Foreground="#E2E0EF" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Margin="16,0,16,14"/>
                                            </Grid>
                                        </controls:RoundedClipBorder>
                                        <TextBlock x:Name="CaptureDescriptionText" Text="Выбери источник записи" Style="{StaticResource Caption}" FontSize="12" Margin="0,10,0,0"/>

                                        <Grid x:Name="CaptureActionsGrid" Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="40"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                                            <Button x:Name="RecordButton" Style="{StaticResource CircularActionButton}" Click="RecordButton_Click" AutomationProperties.Name="Начать или остановить запись">
                                                <Grid><Ellipse x:Name="RecordStartGlyph" Width="32" Height="32" Fill="{StaticResource DangerBrush}"/><Rectangle x:Name="RecordStopGlyph" Width="24" Height="24" RadiusX="5" RadiusY="5" Fill="{StaticResource DangerBrush}" Visibility="Collapsed"/></Grid>
                                            </Button>
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="RecordButtonTitle" Text="Запись" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Начать / остановить" FontSize="11" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Row="2" Style="{StaticResource ShortcutChip}" VerticalAlignment="Center"><TextBlock x:Name="RecordHotkeyHint" Text="Shift + R" FontSize="11"/></Border>
                                            <Button x:Name="ReplayButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="84" MinHeight="84" MaxWidth="350" Margin="10,0" Click="ReplayButton_Click" AutomationProperties.Name="Сохранить последние 30 секунд">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource ClockIcon}" Width="31" Height="31" Stroke="White" Margin="0,0,12,0" />
                                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Сохранить последние" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="30 секунд" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Grid.Column="1" Grid.Row="1" Text="Твой момент. Одно нажатие." Style="{StaticResource Caption}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Grid.Row="2" Style="{StaticResource ShortcutChip}" VerticalAlignment="Center"><TextBlock x:Name="ReplayHotkeyHint" Text="Shift + Z" FontSize="11"/></Border>
                                            <Button x:Name="MicrophoneButton" Grid.Column="2" Style="{StaticResource CircularActionButton}" Click="MicrophoneButton_Click" AutomationProperties.Name="Включить или выключить микрофон">
                                                <Path x:Name="MicrophoneIcon" Style="{StaticResource StudioIcon}" Data="{StaticResource MicIcon}" Width="28" Height="28" Stroke="White"/>
                                            </Button>
                                            <StackPanel Grid.Column="2" Grid.Row="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="MicrophoneButtonTitle" Text="Микрофон" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="MicrophoneStateText" Text="Включён" FontSize="11" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource ShortcutChip}" VerticalAlignment="Center"><TextBlock x:Name="MicrophoneHotkeyHint" Text="Shift + X" FontSize="11"/></Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsPanel}" Padding="16">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource StudioIcon}" Data="{StaticResource ClipsIcon}" Width="19" Height="19" /><TextBlock Text="Последние клипы" Style="{StaticResource SectionHeading}" Margin="10,0,0,0"/></StackPanel>
                                        <Button Style="{StaticResource QuietButton}" Content="Открыть все →" FontSize="12" HorizontalAlignment="Right" Click="ClipsNavButton_Click" MinHeight="28" Padding="6,2"/>
                                        <Grid Grid.Row="1" Margin="0,16,0,0">
                                            <ItemsControl x:Name="RecentClipsItemsControl">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,10,0"/></Style></ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <StackPanel>
                                                        <Button Height="76" Padding="0" Background="{StaticResource InputBrush}" Tag="{Binding FilePath}" Click="OpenClip_Click" AutomationProperties.Name="{Binding Title}" ToolTip="Открыть клип">
                                                            <Grid ClipToBounds="True"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/><Border Background="#DE111218" CornerRadius="5" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"><TextBlock Text="{Binding Duration}" FontSize="11"/></Border></Grid>
                                                        </Button>
                                                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                                                        <TextBlock Text="{Binding SavedAt}" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="RecentClipsEmptyText" Text="Пока здесь тихо. Сохрани свой первый момент." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,36"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="DashboardSettingsRail" Grid.Column="2">
                                <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Path Style="{StaticResource StudioIcon}" Data="{StaticResource CaptureIcon}"  /><TextBlock Text="Источник захвата" Style="{StaticResource SectionHeading}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Монитор" Style="{StaticResource Caption}" VerticalAlignment="Center"/><ComboBox x:Name="DisplayComboBox" Grid.Column="1" DisplayMemberPath="Name" AutomationProperties.Name="Резервный монитор"/></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Частота кадров" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="FpsComboBox" Grid.Column="1" SelectedValuePath="Content" AutomationProperties.Name="Частота кадров"><ComboBoxItem Content="30"/><ComboBoxItem Content="60" IsSelected="True"/><ComboBoxItem Content="120"/></ComboBox>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>
                                        <Grid><TextBlock Text="Качество" Style="{StaticResource Caption}"/><TextBlock Text="Высокое · H.264" HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" FontSize="12"/></Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Path Style="{StaticResource StudioIcon}" Data="{StaticResource AudioIcon}"  /><TextBlock Text="Аудио" Style="{StaticResource SectionHeading}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Системный звук" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center"/><ComboBox x:Name="OutputDeviceComboBox" Grid.Column="1" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Устройство вывода"/></Grid>
                                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Микрофон" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center"/><ComboBox x:Name="InputDeviceComboBox" Grid.Column="1" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Устройство микрофона"/></Grid>
                                        <Grid Margin="0,2,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Микрофон" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                            <Slider x:Name="MicrophoneVolumeSlider" Grid.Column="1" Style="{StaticResource VolumeSlider}" Value="68" AutomationProperties.Name="Громкость микрофона"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=MicrophoneVolumeSlider, StringFormat={}{0:0}%}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Система" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                            <Slider x:Name="OutputVolumeSlider" Grid.Column="1" Style="{StaticResource VolumeSlider}" Value="82" AutomationProperties.Name="Громкость системы"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=OutputVolumeSlider, StringFormat={}{0:0}%}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Path Style="{StaticResource StudioIcon}" Data="{StaticResource KeyboardIcon}"  /><TextBlock Text="Горячие клавиши" Style="{StaticResource SectionHeading}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions><TextBlock Text="Сохранить 30 секунд" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="ReplayHotkeyTextBox" Grid.Column="1" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Сохранить 30 секунд"/></Grid>
                                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions><TextBlock Text="Начать / остановить" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="RecordHotkeyTextBox" Grid.Column="1" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Начать / остановить"/></Grid>
                                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions><TextBlock Text="Микрофон" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="MicrophoneHotkeyTextBox" Grid.Column="1" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Микрофон"/></Grid>
                                        <Grid Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions><TextBlock Text="Открыть галерею" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="GalleryHotkeyTextBox" Grid.Column="1" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Открыть галерею"/></Grid>
                                        <TextBlock Text="Нажми поле, затем сочетание клавиш." Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Button Click="HotkeysNavButton_Click" HorizontalContentAlignment="Stretch" Padding="18,12" Background="{StaticResource PanelBrush}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                        <Path Style="{StaticResource StudioIcon}" Data="{StaticResource SettingsIcon}"  />
                                        <StackPanel Grid.Column="1"><TextBlock Text="Все настройки" Style="{StaticResource SectionHeading}" FontSize="14"/><TextBlock Text="Контроллер и управление" Style="{StaticResource Caption}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                        <Path Style="{StaticResource StudioIcon}" Data="{StaticResource ArrowIcon}" Grid.Column="2" Width="16" Height="16" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Clips page -->
                    <ScrollViewer x:Name="AudioPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="36,30" MaxWidth="1000" HorizontalAlignment="Stretch">
                            <TextBlock Text="Мои клипы" Style="{StaticResource PageHeading}" />
                            <TextBlock Text="Открой момент одним нажатием. Все видео хранятся на твоём компьютере." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,5,0,22" />
                            <TextBlock Text="Поиск по игре или названию" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                            <DockPanel Margin="0,0,0,20"><Button Content="Открыть папку" DockPanel.Dock="Right" Click="OpenClipsFolder_Click" Margin="12,0,0,0" /><Button Content="Обновить" DockPanel.Dock="Right" Click="RefreshClips_Click" Margin="12,0,0,0" /><TextBox x:Name="ClipSearchTextBox" TextChanged="ClipSearch_TextChanged" ToolTip="Поиск по имени игры или клипа" AutomationProperties.Name="Поиск клипов" /></DockPanel>
                            <TextBlock x:Name="GalleryCountText" Text="Нет сохранённых клипов" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,0,0,14" />
                            <ItemsControl x:Name="GalleryItemsControl">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Style="{StaticResource SettingsPanel}" Width="282" Padding="10" Margin="0,0,14,14">
                                        <StackPanel>
                                            <Button Tag="{Binding FilePath}" Click="OpenClip_Click" Padding="0" Height="146" ToolTip="Воспроизвести клип" AutomationProperties.Name="{Binding Title}">
                                                <Grid ClipToBounds="True"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill" /><Border Background="#DE111218" Padding="7,4" CornerRadius="5" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8"><TextBlock Text="{Binding Duration}" FontSize="12" /></Border></Grid>
                                            </Button>
                                            <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,12,0,4" />
                                            <TextBlock Text="{Binding SavedAt}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                            <Button Content="Показать в папке" Tag="{Binding FilePath}" Click="RevealClip_Click" Margin="0,12,0,0" MinHeight="32" Padding="10,5" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="GalleryEmptyPanel" Style="{StaticResource SettingsPanel}" Padding="28">
                                <StackPanel HorizontalAlignment="Center" Margin="0,50">
                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource ClipsIcon}" Width="42" Height="42" Stroke="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Здесь будут твои моменты" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                                    <TextBlock Text="Сохрани replay или начни запись на главной странице." Foreground="{StaticResource MutedBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,18" />
                                    <Button Content="Открыть папку с клипами" Background="{StaticResource AccentBrush}" Click="OpenClipsFolder_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Recording page -->
                    <ScrollViewer x:Name="VideoPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="36,30" MaxWidth="900" HorizontalAlignment="Stretch">
                            <TextBlock Text="Запись" Style="{StaticResource PageHeading}" />
                            <TextBlock Text="Папка сохранения и поведение игрового захвата." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,22" />
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Папка для записей" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="OutputPathTextBox" AutomationProperties.Name="Папка для записей" /><Button Grid.Column="1" Content="Обзор" Margin="10,0,0,0" MinWidth="92" Click="BrowseOutputPath_Click" /></Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Проверка записи и звука" FontSize="18" FontWeight="Bold" />
                                    <TextBlock Text="Отдельный голос, звук игры, исходное видео и журнал кадров. Файлы сохраняются только на этом компьютере. Проверка останавливает replay примерно через 90 секунд или при достижении 2 ГБ." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,10,0,14" />
                                    <WrapPanel><Button x:Name="DiagnosticsButton" Content="Начать проверку (90 секунд)" Click="DiagnosticsButton_Click" Margin="0,0,12,0" /><Button Content="Открыть папку проверки" Click="OpenDiagnosticsButton_Click" /></WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsPanel}">
                                <StackPanel>
                                    <TextBlock Text="Поведение захвата" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <CheckBox x:Name="AutoGameCheckBox" Style="{StaticResource ToggleCheckBox}" Content="Автоматически выбирать активную игру" IsChecked="True" />
                                    <Border Height="1" Background="{StaticResource BorderBrush}" />
                                    <CheckBox x:Name="StartReplayCheckBox" Style="{StaticResource ToggleCheckBox}" Content="Запускать replay-буфер вместе с CLIPALKA" IsChecked="True" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings page -->
                    <ScrollViewer x:Name="HotkeysPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="36,30" MaxWidth="900" HorizontalAlignment="Stretch">
                            <TextBlock Text="Настройки" Style="{StaticResource PageHeading}" />
                            <TextBlock Text="Точное управление CLIPALKA во время игры." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,22" />
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Replay с контроллера" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Text="DualSense по Bluetooth / USB, Flydigi и другие контроллеры Windows. Выбери устройство, нажми «Назначить» и введи сочетание кнопками геймпада." TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,16" />
                                    <TextBlock Text="Устройство" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ControllerComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Tag="Контроллер не подключён" AutomationProperties.Name="Контроллер для replay" MinWidth="0" />
                                    <WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource QuietButton}" Content="Обновить список" Click="RefreshControllers_Click" Padding="12,6" MinHeight="34" Margin="0,0,10,0" /><Button Style="{StaticResource QuietButton}" Content="Контроллеры Windows" Click="OpenWindowsControllers_Click" Padding="12,6" MinHeight="34" Margin="0,0,10,0" /><Button Style="{StaticResource QuietButton}" Content="Скопировать сведения" Click="CopyControllerDetails_Click" Padding="12,6" MinHeight="34" /></WrapPanel>
                                    <TextBlock x:Name="ControllerStatusText" Text="Подключи контроллер, чтобы назначить сочетание" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,10,0,16" />
                                    <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="16,12"><TextBlock x:Name="ControllerBindingText" Text="Не назначено" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /></Border>
                                    <WrapPanel Margin="0,14,0,0"><Button x:Name="LearnControllerButton" Style="{StaticResource PrimaryButton}" MinHeight="42" Content="Назначить сочетание" Click="LearnControllerButton_Click" Margin="0,0,12,0" /><Button Content="Отключить" Click="ClearControllerButton_Click" /></WrapPanel>
                                    <TextBlock Text="Удерживай сочетание 0,4 секунды — сохранится один replay. После срабатывания отпусти все кнопки. Назначение вступает в силу после сохранения настроек. Аналоговые оси не назначаются; отдельные задние кнопки доступны только если их передаёт драйвер." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Хоткеи" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Кликни поле на главной странице и нажми сочетание. Названия клавиш остаются на английском." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,12" />
                                    <CheckBox x:Name="GameOnlyHotkeysCheckBox" Style="{StaticResource ToggleCheckBox}" Content="Разрешать хоткеи только когда активна игра" IsChecked="True" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsPanel}">
                                <StackPanel>
                                    <TextBlock Text="О приложении" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="CLIPALKA v0.9.3 RC2" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,7,0,0" />
                                    <TextBlock Text="Игровая запись, replay и звук — без лишнего." Foreground="{StaticResource SubtleBrush}" FontSize="13" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="ErrorBanner" Grid.Row="0" Visibility="Collapsed" Margin="28,16,28,0" Background="#39202D" BorderBrush="#8C3B54" BorderThickness="1" CornerRadius="10" Padding="16,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource WarningIcon}" Style="{StaticResource StudioIcon}" Stroke="#FF9CB1" Width="20" Height="20"/>
                            <StackPanel Grid.Column="1"><TextBlock x:Name="ErrorBannerTitle" Text="Операция не выполнена" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="ErrorBannerText" Foreground="#F4B9C4" FontSize="13" TextWrapping="Wrap" Margin="0,4,12,0"/></StackPanel>
                            <Button Grid.Column="2" Content="×" Style="{StaticResource QuietButton}" Padding="0" FontSize="20" Click="DismissErrorButton_Click" AutomationProperties.Name="Скрыть сообщение об ошибке"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>
