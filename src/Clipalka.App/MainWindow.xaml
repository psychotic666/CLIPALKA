<Window x:Class="Clipalka.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CLIPALKA" Icon="Assets/clipalka.ico"
        Width="1120" Height="790" MinWidth="940" MinHeight="690"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="326" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}" BorderBrush="#202B40" BorderThickness="0,0,1,0">
            <Grid Margin="28,26,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="58" Height="58" CornerRadius="15" ClipToBounds="True" Margin="0,0,14,0">
                        <Image Source="Assets/clipalka-icon.png" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CLIPALKA" FontSize="23" FontWeight="Bold" />
                        <TextBlock Text="Capture every moment" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Background="#10192A" BorderBrush="#273650" BorderThickness="1"
                        CornerRadius="14" Padding="14,11" Margin="0,24,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="25" Height="25" CornerRadius="12" Background="#19273C">
                            <Ellipse x:Name="ReplayStatusDot" Width="9" Height="9" Fill="#64748B"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ReplayStatusText" Text="Replay выключен" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="Буфер выбранного монитора" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" Foreground="#8E9AB0" FontSize="10"
                               FontWeight="Bold" Margin="2,0,0,10" />

                    <Button x:Name="RecordButton" Click="RecordButton_Click" Background="#D92D45"
                            Height="84" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="Начать или остановить запись">
                        <Grid Margin="15,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19" Background="#33FFFFFF">
                                <Ellipse Width="14" Height="14" Fill="White" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="RecordButtonTitle" Text="Начать запись" FontSize="15" FontWeight="Bold" />
                                <TextBlock x:Name="RecordHotkeyHint" Text="Ctrl + Shift + R" Foreground="#FFE3E7" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="ReplayButton" Click="ReplayButton_Click" Background="{StaticResource AccentBrush}"
                            Height="84" Margin="0,10,0,0" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="Сохранить последние 30 секунд">
                        <Grid Margin="15,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19" Background="#33FFFFFF">
                                <TextBlock Text="↻" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Сохранить 30 секунд" FontSize="15" FontWeight="Bold" />
                                <TextBlock x:Name="ReplayHotkeyHint" Text="Ctrl + Shift + Z" Foreground="#EEE9FF" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="MicrophoneButton" Click="MicrophoneButton_Click" Background="#1B263A"
                            Height="64" Margin="0,10,0,0" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="Включить или выключить микрофон">
                        <Grid Margin="17,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="●" Foreground="{StaticResource SuccessBrush}" FontSize="17" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="MicrophoneButtonTitle" Text="Микрофон включён" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="Нажмите для mute" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="M" Foreground="#90A0B9" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Row="4" Background="#0E1727" BorderBrush="#22314A" BorderThickness="1"
                        CornerRadius="14" Padding="15,13">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource CyanBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Надёжный захват" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="Replay всегда пишет выбранный монитор. Обычная запись возьмёт активную игру или этот же монитор."
                                   Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" LineHeight="15" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="34,27,34,30">
                <Grid Margin="0,0,0,21">
                    <StackPanel>
                        <TextBlock Text="Настройки записи" FontSize="25" FontWeight="Bold" />
                        <TextBlock Text="Видео, звук и управление — всё в одном месте" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" Background="#10271F" BorderBrush="#1F493B" BorderThickness="1"
                            CornerRadius="14" Padding="13,7" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="H.264 High • 192 kbps" Foreground="#8AF0C3" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,13">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#211B42" Margin="0,0,11,0">
                                <TextBlock Text="01" Foreground="#BFAFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Изображение и сохранение" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Куда и с какой плавностью записывать" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Папка для записей" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputPathTextBox" AutomationProperties.Name="Папка для записей" />
                            <Button Grid.Column="1" Content="Обзор" Margin="9,0,0,0" Padding="17,10"
                                    Click="BrowseOutputPath_Click" AutomationProperties.Name="Выбрать папку для записей" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Монитор для replay и резерва" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="DisplayComboBox" DisplayMemberPath="Name" AutomationProperties.Name="Монитор для replay" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="FPS" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="FpsComboBox" SelectedValuePath="Content" AutomationProperties.Name="Частота кадров">
                                    <ComboBoxItem Content="30" />
                                    <ComboBoxItem Content="60" IsSelected="True" />
                                    <ComboBoxItem Content="120" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,13">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#102A31" Margin="0,0,11,0">
                                <TextBlock Text="02" Foreground="#75DFF5" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Звук" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Поддерживаются виртуальные устройства SteelSeries Sonar" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Звук игры / Sonar Game" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="OutputDeviceComboBox" DisplayMemberPath="Name" AutomationProperties.Name="Устройство звука игры" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Микрофон / Sonar Microphone" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="InputDeviceComboBox" DisplayMemberPath="Name" AutomationProperties.Name="Устройство микрофона" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,13">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#281D30" Margin="0,0,11,0">
                                <TextBlock Text="03" Foreground="#F0A8D7" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Горячие клавиши" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Нажмите поле, затем сочетание. Delete отключает хоткей."
                                           Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Запись экрана" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RecordHotkeyTextBox" Style="{StaticResource HotkeyBox}"
                                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Хоткей записи" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Сохранение replay" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ReplayHotkeyTextBox" Style="{StaticResource HotkeyBox}"
                                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Хоткей replay" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Поведение" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <CheckBox x:Name="AutoGameCheckBox" Content="Для обычной записи брать активную игру" IsChecked="True" />
                            <CheckBox x:Name="GameOnlyHotkeysCheckBox" Content="Хоткеи работают только в активной игре" IsChecked="True" Margin="0,3,0,0" />
                            <CheckBox x:Name="StartReplayCheckBox" Content="Включать replay-буфер при запуске" IsChecked="True" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Сохранить" Background="{StaticResource AccentBrush}"
                                MinWidth="126" Padding="22,12" VerticalAlignment="Bottom" Margin="24,0,0,0"
                                Click="SaveSettingsButton_Click" AutomationProperties.Name="Сохранить настройки" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#0B111D" BorderBrush="#202B40"
                BorderThickness="0,1,0,0" Padding="22,11">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource CyanBrush}" Margin="0,0,10,0" />
                    <TextBlock x:Name="StatusTextBlock" Text="Подготовка…" Foreground="#D4DCE9"
                               FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="CLIPALKA  •  v0.3" Foreground="#69768B" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
