<Window x:Class="Clipalka.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CLIPALKA" Icon="Assets/clipalka.ico"
        Width="1060" Height="760" MinWidth="900" MinHeight="650"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1F22">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/clipalka-icon.png" Width="20" Height="20" />
                    <TextBlock Text="CLIPALKA" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Content="—" Click="MinimizeButton_Click"
                            AutomationProperties.Name="Свернуть" />
                    <Button Style="{StaticResource TitleBarButton}" Content="□" Click="MaximizeButton_Click"
                            AutomationProperties.Name="Развернуть или восстановить" />
                    <Button Style="{StaticResource CloseTitleBarButton}" Content="×" Click="CloseButton_Click"
                            FontSize="18" AutomationProperties.Name="Закрыть в трей" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="58" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="#1E1F22" BorderThickness="0,0,0,1" Padding="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="12" ClipToBounds="True">
                                <Image Source="Assets/clipalka-icon.png" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="CLIPALKA" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="GAME CAPTURE" Foreground="#949BA4" FontSize="9" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="10,18,10,6">
                        <TextBlock Text="REPLAY" Foreground="#949BA4" FontSize="10" FontWeight="Bold" Margin="8,0,8,7" />
                        <Border Background="#35373C" CornerRadius="4" Padding="10,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="#232428">
                                    <Ellipse x:Name="ReplayStatusDot" Width="8" Height="8" Fill="#80848E" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock x:Name="ReplayStatusText" Text="Replay выключен" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ReplaySourceText" Text="Источник не выбран" Foreground="#949BA4"
                                               FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="168" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="10,10,10,0">
                        <TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" Foreground="#949BA4" FontSize="10" FontWeight="Bold" Margin="8,0,8,7" />
                        <Button x:Name="RecordButton" Click="RecordButton_Click" Background="#DA373C"
                                Height="48" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Начать или остановить запись">
                            <Grid Margin="11,0">
                                <Ellipse Width="12" Height="12" Fill="White" HorizontalAlignment="Left" />
                                <StackPanel Margin="25,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="RecordButtonTitle" Text="Начать запись" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="RecordHotkeyHint" Text="Ctrl + Shift + R" Foreground="#FFD7D9" FontSize="9" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="ReplayButton" Click="ReplayButton_Click" Background="{StaticResource AccentBrush}"
                                Height="48" Margin="0,7,0,0" HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Сохранить последние 30 секунд">
                            <Grid Margin="11,0">
                                <TextBlock Text="↻" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <StackPanel Margin="25,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Сохранить replay" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ReplayHotkeyHint" Text="Ctrl + Shift + Z" Foreground="#DCDDFF" FontSize="9" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="4" Background="#232428" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="16" Background="#3F4147">
                                <TextBlock Text="C" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MicrophoneButtonTitle" Text="Микрофон включён" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="Нажмите для mute" Foreground="#949BA4" FontSize="9" />
                            </StackPanel>
                            <Button x:Name="MicrophoneButton" Grid.Column="2" Click="MicrophoneButton_Click"
                                    Background="Transparent" Padding="0" MinHeight="34" ToolTip="Включить или выключить микрофон"
                                    AutomationProperties.Name="Включить или выключить микрофон">
                                <TextBlock Text="◉" Foreground="{StaticResource SuccessBrush}" FontSize="18" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource WindowBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border BorderBrush="#1E1F22" BorderThickness="0,0,0,1" Padding="28,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Настройки записи" FontSize="16" FontWeight="Bold" />
                            <Border Width="1" Height="22" Background="#3F4147" Margin="14,0" />
                            <TextBlock Text="Видео, звук и управление" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="#1E1F22" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="H.264 High" Foreground="#DBDEE1" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="760" Margin="32,26,32,38" HorizontalAlignment="Left">
                        <TextBlock Text="ВИДЕО" Foreground="#F2F3F5" FontSize="12" FontWeight="Bold" Margin="0,0,0,14" />
                        <TextBlock Text="Папка для записей" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputPathTextBox" AutomationProperties.Name="Папка для записей" />
                            <Button Grid.Column="1" Content="Обзор" Margin="8,0,0,0" Padding="16,8"
                                    Click="BrowseOutputPath_Click" AutomationProperties.Name="Выбрать папку для записей" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Монитор для replay и резерва" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="DisplayComboBox" DisplayMemberPath="Name" AutomationProperties.Name="Монитор для replay" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Частота кадров" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="FpsComboBox" SelectedValuePath="Content" AutomationProperties.Name="Частота кадров">
                                    <ComboBoxItem Content="30" />
                                    <ComboBoxItem Content="60" IsSelected="True" />
                                    <ComboBoxItem Content="120" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#3F4147" Margin="0,24" />

                        <TextBlock Text="ЗВУК" Foreground="#F2F3F5" FontSize="12" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="Можно выбрать обычные или виртуальные устройства SteelSeries Sonar."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Звук игры / Sonar Game" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="OutputDeviceComboBox" DisplayMemberPath="Name" AutomationProperties.Name="Устройство звука игры" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Микрофон / Sonar Microphone" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="InputDeviceComboBox" DisplayMemberPath="Name" AutomationProperties.Name="Устройство микрофона" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#3F4147" Margin="0,24" />

                        <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" Foreground="#F2F3F5" FontSize="12" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="Нажмите поле, затем нужное сочетание. Delete полностью отключает хоткей."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Начать / остановить запись" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RecordHotkeyTextBox" Style="{StaticResource HotkeyBox}"
                                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Хоткей записи" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Сохранить последние 30 секунд" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ReplayHotkeyTextBox" Style="{StaticResource HotkeyBox}"
                                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Хоткей replay" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#3F4147" Margin="0,24" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ПОВЕДЕНИЕ" Foreground="#F2F3F5" FontSize="12" FontWeight="Bold" Margin="0,0,0,7" />
                                <CheckBox x:Name="AutoGameCheckBox" Style="{StaticResource ToggleCheckBox}"
                                          Content="Для обычной записи брать активную игру" IsChecked="True" />
                                <CheckBox x:Name="GameOnlyHotkeysCheckBox" Style="{StaticResource ToggleCheckBox}"
                                          Content="Хоткеи работают только в активной игре" IsChecked="True" />
                                <CheckBox x:Name="StartReplayCheckBox" Style="{StaticResource ToggleCheckBox}"
                                          Content="Включать replay-буфер при запуске" IsChecked="True" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Сохранить изменения" Background="{StaticResource AccentBrush}"
                                    Padding="18,10" MinWidth="164" VerticalAlignment="Bottom" Margin="28,0,0,2"
                                    Click="SaveSettingsButton_Click" AutomationProperties.Name="Сохранить настройки" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#1E1F22" Padding="12,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusTextBlock" Text="Подготовка…" Foreground="#B5BAC1" FontSize="10" />
                </StackPanel>
                <TextBlock Text="v0.4" Foreground="#80848E" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
