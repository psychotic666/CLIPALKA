<Window x:Class="Clipalka.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CLIPALKA" Width="980" Height="860" MinWidth="860" MinHeight="720"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="38,30,38,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" Background="{StaticResource AccentBrush}" CornerRadius="13" Margin="0,0,13,0">
                            <TextBlock Text="C" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CLIPALKA" FontSize="26" FontWeight="Bold" />
                            <TextBlock Text="Запись игры, звука и важных моментов" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#151E2E" BorderBrush="#29364C" BorderThickness="1"
                        CornerRadius="18" Padding="15,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ReplayStatusDot" Width="9" Height="9" Fill="#64748B" Margin="0,0,9,0" />
                        <TextBlock x:Name="ReplayStatusText" Text="Replay выключен" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="#202B3E" BorderThickness="1"
                    CornerRadius="20" Padding="18" Margin="0,26,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RecordButton" Click="RecordButton_Click" Background="#DC2626" Margin="0,0,7,0" MinHeight="88">
                        <StackPanel>
                            <TextBlock x:Name="RecordButtonTitle" Text="●  Начать запись" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="RecordHotkeyHint" Text="Ctrl + Shift + R" Foreground="#FECACA" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReplayButton" Grid.Column="1" Click="ReplayButton_Click"
                            Background="{StaticResource AccentBrush}" Margin="7,0" MinHeight="88">
                        <StackPanel>
                            <TextBlock Text="↶  Сохранить 30 секунд" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ReplayHotkeyHint" Text="Ctrl + Shift + Z" Foreground="#EDE9FE" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MicrophoneButton" Grid.Column="2" Click="MicrophoneButton_Click" Margin="7,0,0,0" MinHeight="88">
                        <StackPanel>
                            <TextBlock x:Name="MicrophoneButtonTitle" Text="🎙  Микрофон включён" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Нажмите для mute" Foreground="#C3CCDC" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="#202B3E" BorderThickness="1"
                    CornerRadius="20" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Настройки записи" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="Изменения применяются после сохранения" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="#14261F" CornerRadius="10" Padding="11,6" VerticalAlignment="Center">
                            <TextBlock Text="H.264 • High quality • 192 kbps" Foreground="#86EFAC" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <StackPanel Margin="0,0,0,17">
                        <TextBlock Text="Папка для записей" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputPathTextBox" AutomationProperties.Name="Папка для записей" />
                            <Button Grid.Column="1" Content="Выбрать папку" Margin="10,0,0,0" Click="BrowseOutputPath_Click" />
                        </Grid>
                    </StackPanel>

                    <Grid Margin="0,0,0,17">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Резервный монитор" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="DisplayComboBox" DisplayMemberPath="Name" AutomationProperties.Name="Резервный монитор" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Частота кадров" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="FpsComboBox" SelectedValuePath="Content" AutomationProperties.Name="Частота кадров">
                                <ComboBoxItem Content="30" />
                                <ComboBoxItem Content="60" IsSelected="True" />
                                <ComboBoxItem Content="120" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,17">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Звук игры / Sonar Game" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="OutputDeviceComboBox" DisplayMemberPath="Name" AutomationProperties.Name="Устройство звука игры" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Микрофон / Sonar Microphone" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="InputDeviceComboBox" DisplayMemberPath="Name" AutomationProperties.Name="Устройство микрофона" />
                        </StackPanel>
                    </Grid>

                    <Border Background="#0B121E" BorderBrush="#243047" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,1,0,17">
                        <StackPanel>
                            <TextBlock Text="Горячие клавиши" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="Кликните поле и нажмите сочетание. Backspace или Delete отключает хоткей."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,13" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Начать / остановить запись" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="RecordHotkeyTextBox" Style="{StaticResource HotkeyBox}"
                                             PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Хоткей записи" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Сохранить replay" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ReplayHotkeyTextBox" Style="{StaticResource HotkeyBox}"
                                             PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Хоткей replay" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <CheckBox x:Name="AutoGameCheckBox" Content="Автоматически выбирать окно игры" IsChecked="True" />
                            <CheckBox x:Name="GameOnlyHotkeysCheckBox" Content="Хоткеи работают только когда активна игра" IsChecked="True" Margin="0,5,0,0" />
                            <CheckBox x:Name="StartReplayCheckBox" Content="Включать replay-буфер при запуске" IsChecked="True" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Сохранить настройки" Background="{StaticResource AccentBrush}"
                                Padding="22,12" VerticalAlignment="Bottom" Click="SaveSettingsButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="#0D1420" BorderBrush="#202B3E" BorderThickness="1"
                    CornerRadius="13" Padding="15,12" Margin="0,15,0,0">
                <Grid>
                    <Ellipse Width="8" Height="8" Fill="#60A5FA" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusTextBlock" Text="Подготовка…" Foreground="#C5D0E3"
                               TextWrapping="Wrap" Margin="17,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
