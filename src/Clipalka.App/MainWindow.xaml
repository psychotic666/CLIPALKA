<Window x:Class="Clipalka.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Clipalka.App.Controls"
        Title="CLIPALKA" Icon="Assets/clipalka.ico" Width="1585" Height="992" MinWidth="960" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged" SizeChanged="Window_SizeChanged">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/></shell:WindowChrome.WindowChrome>
    <Border x:Name="ShellRoot" Background="{StaticResource StudioCanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
            <Border Background="#292A3444" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CP" Foreground="{StaticResource AccentHoverBrush}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="CLIPALKA" FontSize="21" FontWeight="SemiBold" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" AutomationProperties.Name="Свернуть"><Path Data="M0,5 L12,5" Stroke="{StaticResource TextBrush}" StrokeThickness="1" Width="12" Height="10"/></Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" AutomationProperties.Name="Развернуть или восстановить"><Rectangle Width="12" Height="12" Stroke="{StaticResource TextBrush}" StrokeThickness="1"/></Button>
                        <Button Style="{StaticResource CloseTitleBarButton}" Click="CloseButton_Click" AutomationProperties.Name="Закрыть в трей"><Path Data="M0,0 L12,12 M0,12 L12,0" Stroke="{StaticResource TextBrush}" StrokeThickness="1.2" Width="12" Height="12"/></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="NavigationStrip" Width="700" Height="52" CornerRadius="26" Background="#2D2E39" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <UniformGrid Columns="3">
                        <Button x:Name="DashboardNavButton" Style="{StaticResource StudioTab}" Click="DashboardNavButton_Click" AutomationProperties.Name="Захват"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource StudioIcon}" Data="{StaticResource CaptureIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/><TextBlock Text="Захват" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="ClipsNavButton" Style="{StaticResource StudioTab}" Click="ClipsNavButton_Click" AutomationProperties.Name="Мои клипы"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource StudioIcon}" Data="{StaticResource ClipsIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/><TextBlock Text="Мои клипы" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="HotkeysNavButton" Style="{StaticResource StudioTab}" Click="HotkeysNavButton_Click" AutomationProperties.Name="Настройки"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource StudioIcon}" Data="{StaticResource SettingsIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/><TextBlock Text="Настройки" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" VerticalAlignment="Center"/></StackPanel></Button>
                    </UniformGrid>
                </Border>
                <Border x:Name="ErrorBanner" Grid.Row="1" Visibility="Collapsed" Margin="28,0,28,8" Background="#39202D" BorderBrush="#8C3B54" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                        <Path Style="{StaticResource StudioIcon}" Data="{StaticResource WarningIcon}" Stroke="#FF9CB1" Width="20" Height="20"/>
                        <StackPanel Grid.Column="1"><TextBlock x:Name="ErrorBannerTitle" Text="Операция не выполнена" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="ErrorBannerText" Foreground="#F4B9C4" FontSize="13" TextWrapping="Wrap" Margin="0,4,12,0"/></StackPanel>
                        <Button Grid.Column="2" Content="×" Style="{StaticResource QuietButton}" Padding="0" FontSize="20" Click="DismissErrorButton_Click" AutomationProperties.Name="Скрыть сообщение об ошибке"/>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="DashboardPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="DashboardLayoutGrid" Margin="28,6,28,16" MaxWidth="1480">
                        <StackPanel x:Name="DashboardHeadingGrid" Height="98" HorizontalAlignment="Center">
                            <TextBlock x:Name="GreetingText" Text="Играй. Мы сохраним момент." FontSize="42" LineHeight="52" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Ellipse x:Name="CaptureStateDot" Width="10" Height="10" Fill="{StaticResource SubtleBrush}" Margin="0,0,10,0"/>
                                <TextBlock x:Name="CaptureStateText" Text="Ожидание захвата" Foreground="{StaticResource SubtleBrush}" FontSize="19" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <controls:RoundedClipBorder x:Name="CapturePreviewBorder" Height="312" Background="{StaticResource PreviewBrush}" BorderBrush="#464855" BorderThickness="1" CornerRadius="18">
                            <Grid>
                                <Image x:Name="CapturePreviewImage" Stretch="UniformToFill"/>
                                <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#000D0F16" Offset="0.6"/><GradientStop Color="#900D0F16" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                <StackPanel x:Name="PreviewEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource CaptureIcon}" Width="48" Height="48" Stroke="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Здесь появится твой первый момент" FontSize="26" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Запусти игру и сохрани последние 30 секунд" Style="{StaticResource Caption}" FontSize="15" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                                <Border Background="#D01A1B24" CornerRadius="14" Padding="14,7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18">
                                    <TextBlock x:Name="PreviewCaptionText" Text="Нет сохранённых клипов" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="650"/>
                                </Border>
                                <Border Background="#D01A1B24" CornerRadius="14" Padding="14,7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18">
                                    <TextBlock x:Name="CaptureQualityText" Text="H.264 · 60 FPS · Stereo" FontSize="14"/>
                                </Border>
                                <Button x:Name="OpenLatestClipButton" Background="#D01A1B24" BorderThickness="0" Padding="16,8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18" Click="OpenClip_Click" IsEnabled="False" AutomationProperties.Name="Открыть последний клип">
                                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource StudioIcon}" Data="{StaticResource PlayIcon}" Width="16" Height="16" Stroke="White" Margin="0,0,8,0"/><TextBlock x:Name="LatestClipDurationText" Text="Открыть клип" FontSize="14" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </Grid>
                        </controls:RoundedClipBorder>

                        <Grid x:Name="CaptureActionsGrid" Margin="0,18,0,0" Height="84">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="RecordButton" Style="{StaticResource StudioActionButton}" Click="RecordButton_Click" AutomationProperties.Name="Начать или остановить запись">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid Margin="0,0,18,0" VerticalAlignment="Center"><Ellipse x:Name="RecordStartGlyph" Width="30" Height="30" Fill="{StaticResource DangerBrush}"/><Rectangle x:Name="RecordStopGlyph" Width="26" Height="26" RadiusX="5" RadiusY="5" Fill="{StaticResource DangerBrush}" Visibility="Collapsed"/></Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="RecordButtonTitle" Text="Начать запись" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="RecordHotkeyHint" Text="Shift + R" Foreground="{StaticResource MutedBrush}" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Name="ReplayButton" Grid.Column="2" Style="{StaticResource StudioReplayButton}" Height="84" MinHeight="84" Click="ReplayButton_Click" AutomationProperties.Name="Сохранить последние 30 секунд">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource SaveClipIcon}" Width="32" Height="32" Stroke="White" Margin="0,0,18,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="ReplayButtonTitle" Text="Сохранить 30 секунд" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="ReplayHotkeyHint" Text="Shift + Z" Foreground="#E4D9FF" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Name="MicrophoneButton" Grid.Column="4" Style="{StaticResource StudioActionButton}" Click="MicrophoneButton_Click" AutomationProperties.Name="Включить или выключить микрофон">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Path x:Name="MicrophoneIcon" Style="{StaticResource StudioIcon}" Data="{StaticResource MicIcon}" Width="28" Height="32" Stroke="{StaticResource SuccessBrush}" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="MicrophoneButtonTitle" Text="Микрофон включён" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="MicrophoneHotkeyHint" Text="Shift + X" Foreground="{StaticResource MutedBrush}" FontSize="16" Margin="0,4,0,0"/></StackPanel>
                                    <Border x:Name="MicrophoneToggleTrack" Grid.Column="2" Width="46" Height="26" CornerRadius="13" Background="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="14,0,0,0"><Ellipse x:Name="MicrophoneToggleThumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Right" Margin="3"/></Border>
                                </Grid>
                            </Button>
                        </Grid>

                        <Grid x:Name="QuickSettingsGrid" Margin="0,16,0,0" Height="52">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource StudioQuickButton}" Click="VideoNavButton_Click" AutomationProperties.Name="Настроить источник захвата">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                                    <Path x:Name="SourceIdentityIcon" Style="{StaticResource StudioIcon}" Data="{StaticResource GameIcon}" Stroke="{StaticResource TextBrush}"/>
                                    <TextBlock x:Name="ReplaySourceText" Grid.Column="1" Text="Источник не выбран" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource ChevronRightIcon}" Grid.Column="2" Width="12" Height="14"/>
                                </Grid>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource StudioQuickButton}" Click="AudioSettingsNavButton_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource AudioIcon}" Stroke="{StaticResource TextBrush}"/>
                                    <TextBlock x:Name="AudioSummaryText" Grid.Column="1" Text="Аудио: системное устройство" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource ChevronRightIcon}" Grid.Column="2" Width="12" Height="14"/>
                                </Grid>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource StudioQuickButton}" Click="OpenClipsFolder_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions><Path Style="{StaticResource StudioIcon}" Data="{StaticResource FolderIcon}" Stroke="{StaticResource TextBrush}"/><TextBlock Grid.Column="1" Text="Папка клипов" FontSize="16" VerticalAlignment="Center"/><Path Style="{StaticResource StudioIcon}" Data="{StaticResource ChevronRightIcon}" Grid.Column="2" Width="12" Height="14"/></Grid>
                            </Button>
                        </Grid>

                        <Grid x:Name="RecentClipsHeader" Margin="0,24,0,12" Height="34"><TextBlock Text="Последние клипы" FontSize="24" FontWeight="SemiBold"/><Button Content="Все клипы →" Style="{StaticResource QuietButton}" FontSize="14" HorizontalAlignment="Right" MinHeight="28" Padding="10,0" Click="ClipsNavButton_Click"/></Grid>
                        <Grid>
                            <ItemsControl x:Name="RecentClipsItemsControl">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,16,0"/></Style></ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel>
                                        <Button Height="122" Padding="0" Background="{StaticResource InputBrush}" Tag="{Binding FilePath}" Click="OpenClip_Click" AutomationProperties.Name="{Binding Title}" ToolTip="Открыть клип">
                                            <Grid ClipToBounds="True"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/><Border Background="#D01A1B24" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"><TextBlock Text="{Binding Duration}" FontSize="13"/></Border></Grid>
                                        </Button>
                                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding SavedAt}" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="RecentClipsEmptyText" Text="Клипы появятся здесь после первого сохранения" Style="{StaticResource Caption}" FontSize="16" HorizontalAlignment="Center" Margin="0,30"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                    <!-- Clips page -->
                    <ScrollViewer x:Name="AudioPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="32,24" MaxWidth="1340" HorizontalAlignment="Stretch">
                            <TextBlock Text="Мои клипы" Style="{StaticResource PageHeading}" />
                            <TextBlock Text="Открой момент одним нажатием. Все видео хранятся на твоём компьютере." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,5,0,22" />
                            <TextBlock Text="Поиск по игре или названию" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                            <DockPanel Margin="0,0,0,20"><Button Content="Открыть папку" DockPanel.Dock="Right" Click="OpenClipsFolder_Click" Margin="12,0,0,0" /><Button Content="Обновить" DockPanel.Dock="Right" Click="RefreshClips_Click" Margin="12,0,0,0" /><TextBox x:Name="ClipSearchTextBox" TextChanged="ClipSearch_TextChanged" ToolTip="Поиск по имени игры или клипа" AutomationProperties.Name="Поиск клипов" /></DockPanel>
                            <TextBlock x:Name="GalleryCountText" Text="Нет сохранённых клипов" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,0,0,14" />
                            <ItemsControl x:Name="GalleryItemsControl">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Style="{StaticResource SettingsPanel}" Width="304" Padding="10" Margin="0,0,14,14">
                                        <StackPanel>
                                            <Button Tag="{Binding FilePath}" Click="OpenClip_Click" Padding="0" Height="160" ToolTip="Воспроизвести клип" AutomationProperties.Name="{Binding Title}">
                                                <Grid ClipToBounds="True"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill" /><Border Background="#DE111218" Padding="7,4" CornerRadius="5" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8"><TextBlock Text="{Binding Duration}" FontSize="12" /></Border></Grid>
                                            </Button>
                                            <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,12,0,4" />
                                            <TextBlock Text="{Binding SavedAt}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                            <Button Content="Показать в папке" Tag="{Binding FilePath}" Click="RevealClip_Click" Margin="0,12,0,0" MinHeight="32" Padding="10,5" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="GalleryEmptyPanel" Style="{StaticResource SettingsPanel}" Padding="28">
                                <StackPanel HorizontalAlignment="Center" Margin="0,50">
                                    <Path Style="{StaticResource StudioIcon}" Data="{StaticResource ClipsIcon}" Width="42" Height="42" Stroke="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Здесь будут твои моменты" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                                    <TextBlock Text="Сохрани replay или начни запись на главной странице." Foreground="{StaticResource MutedBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,18" />
                                    <Button Content="Открыть папку с клипами" Background="{StaticResource AccentBrush}" Click="OpenClipsFolder_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>



                <Grid x:Name="SettingsShell" Grid.Row="2" Visibility="Collapsed" MaxWidth="1180" Margin="32,20,32,24">
                    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock Text="Настройки" Style="{StaticResource PageHeading}"/><TextBlock Text="Всё для твоей записи — в одном месте." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><Button x:Name="SaveAllSettingsButton" Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" MinHeight="42" Padding="20,8" Click="SaveSettingsButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Применить настройки видео, звука и горячих клавиш"/></Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="VideoNavButton" Content="Видео и файлы" Style="{StaticResource SettingsTab}" Click="VideoNavButton_Click"/>
                        <Button x:Name="AudioSettingsNavButton" Content="Аудио" Style="{StaticResource SettingsTab}" Click="AudioSettingsNavButton_Click" Margin="8,0"/>
                        <Button x:Name="ControlsNavButton" Content="Клавиатура и геймпад" Style="{StaticResource SettingsTab}" Click="ControlsNavButton_Click"/>
                    </StackPanel>
                    <ScrollViewer x:Name="VideoPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,12,16">
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,16"><StackPanel>
                                <TextBlock Text="Изображение" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,22"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,0,20"><TextBlock Text="Резервный монитор" Style="{StaticResource FieldLabel}" FontSize="14"/><ComboBox x:Name="DisplayComboBox" DisplayMemberPath="Name" AutomationProperties.Name="Резервный монитор"/></StackPanel>
                                    <StackPanel Grid.Column="2"><StackPanel Margin="0,0,0,20"><TextBlock Text="Частота кадров" Style="{StaticResource FieldLabel}" FontSize="14"/><ComboBox x:Name="FpsComboBox" SelectedValuePath="Content" AutomationProperties.Name="Частота кадров"><ComboBoxItem Content="30"/><ComboBoxItem Content="60" IsSelected="True"/><ComboBoxItem Content="120"/></ComboBox></StackPanel></StackPanel>
                                </Grid>
                                <TextBlock Text="При автоматическом захвате игра остаётся источником при переключении окон. Монитор используется для записи экрана." Style="{StaticResource Caption}" FontSize="14"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,16"><StackPanel>
                                <TextBlock Text="Папка для записей" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputPathTextBox" AutomationProperties.Name="Папка для записей"/><Button Grid.Column="1" Content="Обзор…" Margin="12,0,0,0" MinWidth="100" Click="BrowseOutputPath_Click"/></Grid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,16"><StackPanel>
                                <TextBlock Text="Поведение захвата" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                <CheckBox x:Name="AutoGameCheckBox" Style="{StaticResource ToggleCheckBox}" Content="Автоматически выбирать активную игру" IsChecked="True"/>
                                <CheckBox x:Name="StartReplayCheckBox" Style="{StaticResource ToggleCheckBox}" Content="Запускать replay вместе с CLIPALKA" IsChecked="True"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsPanel}"><StackPanel>
                                <TextBlock Text="Проверка записи и звука" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Сохраняет отдельно голос, звук игры, видео и журнал кадров на этом компьютере. Проверка останавливает replay примерно через 90 секунд или при достижении 2 ГБ." Style="{StaticResource Caption}" FontSize="14" Margin="0,12,0,18"/>
                                <WrapPanel><Button x:Name="DiagnosticsButton" Content="Начать проверку (90 секунд)" Click="DiagnosticsButton_Click" Margin="0,0,12,0"/><Button Content="Открыть папку проверки" Click="OpenDiagnosticsButton_Click"/></WrapPanel>
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="SoundPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,12,16">
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,16"><StackPanel>
                                <TextBlock Text="Системный звук" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
                                <StackPanel Margin="0,0,0,20"><TextBlock Text="Устройство вывода / Sonar Gaming" Style="{StaticResource FieldLabel}" FontSize="14"/><ComboBox x:Name="OutputDeviceComboBox" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Устройство вывода"/></StackPanel>
                                <TextBlock Text="В клип попадёт звук, проходящий через выбранное устройство." Style="{StaticResource Caption}" FontSize="14" Margin="0,0,0,16"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider x:Name="OutputVolumeSlider" Style="{StaticResource VolumeSlider}" Value="100" AutomationProperties.Name="Громкость системы"/><TextBlock Grid.Column="1" Text="{Binding Value, ElementName=OutputVolumeSlider, StringFormat={}{0:0}%}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource SettingsPanel}"><StackPanel>
                                <TextBlock Text="Микрофон" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
                                <StackPanel Margin="0,0,0,20"><TextBlock Text="Устройство ввода / Sonar Microphone" Style="{StaticResource FieldLabel}" FontSize="14"/><ComboBox x:Name="InputDeviceComboBox" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Устройство микрофона"/></StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider x:Name="MicrophoneVolumeSlider" Style="{StaticResource VolumeSlider}" Value="100" AutomationProperties.Name="Громкость микрофона"/><TextBlock Grid.Column="1" Text="{Binding Value, ElementName=MicrophoneVolumeSlider, StringFormat={}{0:0}%}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="HotkeysPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,12,16">
                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Replay с контроллера" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Text="DualSense по Bluetooth / USB, Flydigi и другие контроллеры Windows. Выбери устройство, нажми «Назначить» и введи сочетание кнопками геймпада." TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,16" />
                                    <TextBlock Text="Устройство" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ControllerComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Tag="Контроллер не подключён" AutomationProperties.Name="Контроллер для replay" MinWidth="0" />
                                    <WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource QuietButton}" Content="Обновить список" Click="RefreshControllers_Click" Padding="12,6" MinHeight="34" Margin="0,0,10,0" /><Button Style="{StaticResource QuietButton}" Content="Контроллеры Windows" Click="OpenWindowsControllers_Click" Padding="12,6" MinHeight="34" Margin="0,0,10,0" /><Button Style="{StaticResource QuietButton}" Content="Скопировать сведения" Click="CopyControllerDetails_Click" Padding="12,6" MinHeight="34" /></WrapPanel>
                                    <TextBlock x:Name="ControllerStatusText" Text="Подключи контроллер, чтобы назначить сочетание" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,10,0,16" />
                                    <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="16,12"><TextBlock x:Name="ControllerBindingText" Text="Не назначено" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /></Border>
                                    <WrapPanel Margin="0,14,0,0"><Button x:Name="LearnControllerButton" Style="{StaticResource PrimaryButton}" MinHeight="42" Content="Назначить сочетание" Click="LearnControllerButton_Click" Margin="0,0,12,0" /><Button Content="Отключить" Click="ClearControllerButton_Click" /></WrapPanel>
                                    <TextBlock Text="Удерживай сочетание 0,4 секунды — сохранится один replay. После срабатывания отпусти все кнопки. Назначение вступает в силу после сохранения настроек. Аналоговые оси не назначаются; отдельные задние кнопки доступны только если их передаёт драйвер." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,16"><StackPanel>
                                <TextBlock Text="Горячие клавиши" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Нажми поле и введи сочетание на клавиатуре. Escape отключает хоткей. Названия клавиш всегда на английском." Style="{StaticResource Caption}" FontSize="14" Margin="0,10,0,22"/>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock Text="Начать / остановить запись" FontSize="15" VerticalAlignment="Center"/><TextBox x:Name="RecordHotkeyTextBox" Grid.Column="1" Style="{StaticResource HotkeyBox}" MinHeight="44" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Начать / остановить запись"/></Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock Text="Сохранить последние 30 секунд" FontSize="15" VerticalAlignment="Center"/><TextBox x:Name="ReplayHotkeyTextBox" Grid.Column="1" Style="{StaticResource HotkeyBox}" MinHeight="44" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Сохранить последние 30 секунд"/></Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock Text="Вкл. / выкл. микрофон" FontSize="15" VerticalAlignment="Center"/><TextBox x:Name="MicrophoneHotkeyTextBox" Grid.Column="1" Style="{StaticResource HotkeyBox}" MinHeight="44" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Вкл. / выкл. микрофон"/></Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock Text="Открыть галерею" FontSize="15" VerticalAlignment="Center"/><TextBox x:Name="GalleryHotkeyTextBox" Grid.Column="1" Style="{StaticResource HotkeyBox}" MinHeight="44" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" AutomationProperties.Name="Открыть галерею"/></Grid>
                                <CheckBox x:Name="GameOnlyHotkeysCheckBox" Style="{StaticResource ToggleCheckBox}" Content="Разрешать хоткеи только когда активна игра" IsChecked="True" Margin="0,8,0,0"/>
                            </StackPanel></Border>
                            <TextBlock Text="CLIPALKA v0.9.3 RC2 · Все клипы хранятся на твоём компьютере" Style="{StaticResource Caption}" FontSize="13" Margin="4,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#80171921" BorderBrush="#353541" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="ReplayStatusDot" Width="6" Height="6" Fill="{StaticResource SubtleBrush}" Margin="0,0,7,0"/><TextBlock x:Name="ReplayStatusText" Text="Replay выключен" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0"/></StackPanel>
                    <TextBlock x:Name="CaptureDescriptionText" Grid.Column="1" Text="Replay-буфер выключен" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock x:Name="StatusTextBlock" Grid.Column="2" Text="Готов к захвату" Foreground="{StaticResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Button x:Name="ToggleReplayButton" Grid.Column="3" Content="Включить replay" Style="{StaticResource QuietButton}" MinHeight="24" Padding="8,0" FontSize="11" Click="ToggleReplayButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
