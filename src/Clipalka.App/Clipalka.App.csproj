<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>CLIPALKA</AssemblyName>
    <RootNamespace>Clipalka.App</RootNamespace>
    <Version>0.9.3-rc.4</Version>
    <FileVersion>0.9.3.3</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\clipalka.ico</ApplicationIcon>
    <ClipalkaRecorderPath>$(MSBuildProjectDirectory)/../../artifacts/native/ScreenRecorderLib.dll</ClipalkaRecorderPath>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\clipalka-icon.png" />
    <Resource Include="Assets\clipalka.ico" />
    <Resource Include="Assets\studio-demo.png" />
    <Content Include="../../native/LICENSE-ScreenRecorderLib.txt" Link="LICENSE-ScreenRecorderLib.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/LICENSE-NAudio.txt" Link="LICENSE-NAudio.txt" CopyToOutputDirectory="PreserveNewest" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Clipalka.Core\Clipalka.Core.csproj" />
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <!-- SRL's NuGet target injects the stock reference. Replace it after injection,
       so restore/build/publish all select the patched binary consistently. -->
  <Target Name="SelectClipalkaRecorder" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="InjectReference">
    <Error Condition="'$(OS)' == 'Windows_NT' and !Exists('$(ClipalkaRecorderPath)')"
           Text="Build the patched recorder first: pwsh -File native/Build-Recorder.ps1" />
    <ItemGroup Condition="Exists('$(ClipalkaRecorderPath)')">
      <Reference Remove="ScreenRecorderLib" />
      <Reference Include="ScreenRecorderLib">
        <HintPath>$(ClipalkaRecorderPath)</HintPath>
        <Private>true</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
