<Window x:Class="Clipalka.App.CaptureNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="388" Height="120" SizeToContent="Manual"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False">
    <Border x:Name="ToastRoot" Margin="10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="14" IsHitTestVisible="False">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="AccentBar" Background="{StaticResource AccentBrush}" CornerRadius="14,0,0,14"/>
            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="{StaticResource InputBrush}" VerticalAlignment="Center">
                <Path x:Name="IconPath" Style="{StaticResource StudioIcon}" Data="{StaticResource CheckIcon}" Stroke="{StaticResource AccentHoverBrush}" Width="22" Height="22"/>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CLIPALKA" Foreground="{StaticResource SubtleBrush}" FontSize="10" FontWeight="SemiBold"/>
                    <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{StaticResource SuccessBrush}" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TitleText" Text="Replay сохранён" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock x:Name="MessageText" Text="Последние 30 секунд готовы" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
